# ============================================
# 根目录 .gitignore（Docker 部署相关）
# ============================================
# 注意：my-app / resume-optimizer 各自有自己的 .gitignore，
# 这个文件只管根目录下新增的 Docker 部署文件。

# Docker 环境变量（含 JWT 密钥、DeepSeek API Key，绝不提交）
.env.docker

# 若改用 bind mount 持久化数据库，取消下面注释
# pgdata/


.workbuddy

.trae

# ============================================
# 根目录工具壳（本地提交校验用）
# package.json / package-lock.json / lefthook.yml 需提交，
# 保证换机器或新克隆时钩子工具版本一致；
# 只有依赖目录忽略。
# ============================================
node_modules/

# ESLint 持久化缓存（pre-push 钩子生成，按文件内容哈希命中，不入库）
**/.eslintcache

