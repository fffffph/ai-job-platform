{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "DeepSeek / 通用 sk- 风格 API Key",
            "pattern": "/sk-[a-zA-Z0-9_-]{20,}/"
          },
          {
            "name": "硬编码的 JWT 签名密钥赋值",
            "pattern": "/(JWT_SECRET|TOKEN_SECRET|SESSION_SECRET)\\s*[:=]\\s*[\"'](?!change|your|xxx|placeholder|example|here|test|dev|dummy)[^\"'\\s]{12,}[\"']/i"
          },
          {
            "name": "疑似 DeepSeek 官方域名下的明文 key",
            "pattern": "/DEEPSEEK_API_KEY\\s*[:=]\\s*[\"']sk-[^\"']{10,}[\"']/"
          }
        ]
      }
    }
  ],
  "allowMessageIds": []
}
