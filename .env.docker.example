# ============================================
# Docker 部署环境变量（示例模板）
# ============================================
# 使用方法：
#   1. 复制本文件为 .env.docker：  cp .env.docker.example .env.docker
#   2. 填写真实值（尤其 JWT_SECRET、各 API Key）
#   3. .env.docker 已加入根目录 .gitignore，切勿提交
#
# 说明：
#   1. 这个文件由 docker-compose 的 env_file 读取，注入到容器里
#   2. 修改后需要重建/重启容器才生效：
#        docker compose up -d --force-recreate
#      注意：NEXT_PUBLIC_* 变量例外，它必须重新 build 才生效
#
# 用法：
#   直接使用即可，compose 里已配置 env_file: .env.docker

# ---------- 数据库 ----------
# 这些值会同时被 postgres 容器（初始化数据库）和 server 容器（连接）使用
# 本地开发用默认弱密码没问题；正式部署请改成强密码
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=careerai

# ---------- JWT 鉴权 ----------
# ⚠️ 生产环境务必更换！生成方式：openssl rand -base64 32
JWT_SECRET=careerai-dev-jwt-secret-change-in-production
# 有效期：数字+单位（s/m/h/d），例如 7d = 7 天
JWT_EXPIRES_IN=7d

# ---------- Bcrypt 加密强度 ----------
# 盐轮数，越大越安全但越慢，推荐 10~12
BCRYPT_SALT_ROUNDS=10

# ---------- AI 服务（DeepSeek）----------
# 申请地址：https://platform.deepseek.com/
#
# 【重要变更】现在优先使用「用户在个人中心自行配置的 Key」。
# DEEPSEEK_API_KEY 仅作为可选的服务端兜底默认值（用户未配置时才使用）。
# ⚠️ 留空 = 无兜底，用户必须在个人中心配置 Key 后才能使用 AI 简历优化。
DEEPSEEK_API_KEY=

# ---------- DeepSeek Key 加密 ----------
# 用于加密存储用户配置的 DeepSeek API Key（AES-256-GCM）。
# ⚠️ 留空则回退用 JWT_SECRET 派生密钥；生产环境建议显式配置，
#    且配置后不要随意更改，否则已存密文无法解密。
# 生成方式：openssl rand -base64 32
DEEPSEEK_ENCRYPTION_KEY=

# ---------- AI 服务（SiliconFlow）----------
# SiliconFlow API Key - https://cloud.siliconflow.cn/me/account/ak
# 用于 Embedding（向量化），优先使用用户在个人中心配置的 Key，此为服务端兜底
# ⚠️ 生产环境建议配置真实 Key
SILICONFLOW_API_KEY=
