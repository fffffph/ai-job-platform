# ============================================
# 主应用环境变量配置（示例模板）
# ============================================
# 使用方法：
#   1. 复制本文件为 .env.local：  cp .env.example .env.local
#   2. 填写真实值
#   3. .env* 已加入 my-app/.gitignore（.env.example 除外），切勿提交真实密钥

# ---------- 后端 API 基础地址 ----------
# 前端 axios 请求的 baseURL（api/modules/* 中使用）。
# 开发环境：指向 Express 后端，例如 http://localhost:4000
# 生产/Docker：留空字符串 = 使用相对路径 → 走同源 → 由 nginx 转发到后端
#   （Docker 构建时通过 build arg 注入空值，见 docker-compose.yml）
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- DeepSeek API Key（仅旧版 Next.js 路由使用）----------
# 供历史 API 路由 /api/chat、/api/parse-resume 使用（向后兼容）。
# 当前简历优化/职位推荐等核心能力已迁移到 Express 后端（my-app/server），
# 此 Key 仅在使用旧路由时才需要，可留空。
DEEPSEEK_API_KEY=
