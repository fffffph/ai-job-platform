/**
 * ============================================
 * Prisma Schema —— 数据库模型定义（Prisma 7）
 * ============================================
 *
 * 【Prisma 7 变更说明】
 * datasource 块中不再支持 `url` 属性。
 * 数据库连接 URL 通过 prisma.config.ts 配置（迁移时使用）
 * 和 PrismaClient 构造函数的 datasourceUrl 参数（运行时使用）。
 *
 * 【迁移命令（Prisma 7）】
 * npx prisma migrate dev --name init   → 创建数据库表（读取 prisma.config.ts 的 URL）
 * npx prisma generate                   → 生成 Prisma Client 类型
 * npx prisma studio                     → 打开数据库可视化界面
 *
 * @see https://pris.ly/d/config-datasource
 */

generator client {
  provider = "prisma-client-js"
}

/**
 * 数据源：PostgreSQL
 *
 * Prisma 7 中 url 配置已移至 prisma.config.ts 和 PrismaClient 构造函数。
 * 此 datasource 块仅声明数据库类型。
 */
datasource db {
  provider = "postgresql"
}

/**
 * ============================================
 * User 模型 —— 用户表
 * ============================================
 *
 * 【字段说明】
 * - id        : UUID 主键，自动生成，全局唯一
 * - email     : 邮箱，唯一索引，用于登录
 * - password  : 密码哈希（bcrypt 加密后的密文，不存储明文！）
 * - name      : 用户昵称/姓名，可选
 * - avatar    : 头像图片 URL，null 时前端用首字母占位
 * - bio       : 个人简介，可选
 * - createdAt : 注册时间，自动生成
 * - updatedAt : 最后更新时间，Prisma 自动管理
 *
 * 【安全设计】
 * 密码字段不存储明文！注册时通过 bcrypt.hash() 加密后存入数据库，
 * 登录时通过 bcrypt.compare() 比对明文与密文。
 *
 * 【索引说明】
 * @@unique([email]) — 邮箱唯一约束，确保同一邮箱只能注册一次
 *                     同时自动创建索引，加速按邮箱查询
 */
model User {
  id        String   @id @default(uuid()) @map("id")
  email     String   @unique @map("email")
  password  String   @map("password")
  name      String?  @map("name")
  avatar    String?  @map("avatar")
  bio       String?  @map("bio")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /**
   * DeepSeek API Key 密文（用户自行配置，服务端 AES-256-GCM 加密后存储）
   * - 明文绝不入库、绝不写日志、绝不返回前端
   * - 按用户隔离，只有本用户能通过认证接口读写
   * - null 表示未配置
   */
  deepseekKeyCipher    String?  @map("deepseek_key_cipher")
  /** DeepSeek API Key 最后配置/更新时间 */
  deepseekKeyUpdatedAt DateTime? @map("deepseek_key_updated_at")

  /**
   * SiliconFlow（硅基流动）API Key 密文（用户自行配置，服务端 AES-256-GCM 加密后存储）
   * 用于知识库 RAG 的 Embedding 向量化，与 DeepSeek Key 一样按用户隔离加密存储
   */
  siliconflowKeyCipher    String?  @map("siliconflow_key_cipher")
  /** SiliconFlow API Key 最后配置/更新时间 */
  siliconflowKeyUpdatedAt DateTime? @map("siliconflow_key_updated_at")

  // 【P5 新增】用户求职画像（1:1，用于职位推荐的个性化记忆）
  profile UserProfile?

  // 【P1 角色地基】用户-角色多对多关联（用于权限控制与菜单过滤）
  userRoles UserRole[]

  @@map("users")
}

// 【P5 新增】============================================
// UserProfile 模型 —— 用户求职画像
// ============================================
/**
 * 用户求职画像（Memory 层的结构化记忆）
 *
 * 存储用户的求职偏好，供职位发现 Agent 做个性化推荐时读取，
 * 实现「跨轮记忆」——用户首次填写求职意向后，下次无需重复输入。
 *
 * 【字段说明】
 * - city           : 期望城市（如 "西安"）
 * - skills         : 技能栈（如 "React,TypeScript,微前端,Node.js"）
 * - expectedSalary : 期望薪资（如 "12k-18k"）
 * - jobTitle       : 求职方向/岗位（如 "前端开发工程师"）
 *
 * 【1:1 关系】
 * 每个用户至多一条画像记录，userId 唯一索引保证。
 */
model UserProfile {
  id             String   @id @default(uuid()) @map("id")
  userId         String   @unique @map("user_id")
  jobTitle       String?  @map("job_title")
  city           String?  @map("city")
  skills         String?  @map("skills")
  expectedSalary String?  @map("expected_salary")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// 【P3 新增】============================================
// Document 模型 —— 知识库文档
// ============================================
/// 知识库文档（用户上传的面试题/JD/笔记等）
model Document {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  title     String   @map("title")
  content   String   @map("content")          // 原始全文（保留，供溯源）
  keywords  String?  @map("keywords")          // 逗号分隔检索词（提升检索命中，选填）
  category  String?  @map("category")          // 分类标签（如「前端/React」，选填）
  createdAt DateTime @default(now()) @map("created_at")

  chunks    Chunk[]

  @@index([userId])
  @@map("documents")
}

// 【知识库文件真相源】============================================
// KnowledgeFile 模型 —— 用户上次上传的原始 Excel 文件
// ============================================
/// 用户上次上传的原始 Excel 文件（供「下载上次文件」继续编辑）
model KnowledgeFile {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @unique @map("user_id")
  filename  String   @map("filename")
  content   Bytes    @map("content")          // 原始 .xlsx 字节
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_files")
}

// 【P3 新增】============================================
// Chunk 模型 —— 文档分块（含向量）
// ============================================
/// 文档分块（含向量）
model Chunk {
  id          String   @id @default(uuid()) @map("id")
  documentId  String   @map("document_id")
  chunkIndex  Int      @map("chunk_index")     // 分块序号，用于溯源定位
  content     String   @map("content")          // 分块文本
  embedding   Unsupported("vector(1024)")?      // 1024 维向量（bge-m3）
  createdAt   DateTime @default(now()) @map("created_at")

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunks")
}

// 【P6 新增】============================================
// TraceRun 模型 —— 一次 AI 执行（Trace 落库）
// ============================================
/// 一次 AI 图执行的可观测记录（P6 把 trace 从内存落库）
/// 一次「简历分析 / 知识库问答 / 职位推荐」对应一条 run，
/// 下挂多条节点级 TraceEvent，实现决策过程的持久化与历史回放。
model TraceRun {
  id              String   @id @default(uuid()) @map("id")
  userId          String   @map("user_id")
  /// 图类型：resume（简历分析）/ rag（知识库问答）/ jobs（职位发现）
  type            String   @map("type")
  /// 执行结果：success / error
  status          String   @default("success") @map("status")
  /// 节点数量
  nodeCount       Int      @default(0) @map("node_count")
  /// 总耗时（毫秒，各节点 durationMs 之和）
  totalDurationMs Int      @default(0) @map("total_duration_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  events          TraceEvent[]

  @@index([userId, createdAt])
  @@map("trace_runs")
}

// 【P6 新增】============================================
// TraceEvent 模型 —— 单个节点执行事件（Trace 落库）
// ============================================
/// 单个 AI 节点的执行追踪记录（持久化版）
/// input/output 存 JSON（Json 类型），序列化失败时降级为 null。
model TraceEvent {
  id         String   @id @default(uuid()) @map("id")
  runId      String   @map("run_id")
  nodeName   String   @map("node_name")
  /// 节点执行顺序（从 0 开始，用于回放时保持原始顺序）
  order      Int      @map("event_order")
  /// 节点输入（JSON，已脱敏/序列化）
  input      Json?    @map("input")
  /// 节点输出（JSON）
  output     Json?    @map("output")
  durationMs Int      @map("duration_ms")
  /// 事件发生时间（ISO 8601 字符串，保留原始值）
  timestamp  String   @map("timestamp")
  createdAt  DateTime @default(now()) @map("created_at")

  run        TraceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("trace_events")
}

// 【P1 新增】============================================
// Role 模型 —— 角色表（RBAC 权限地基）
// ============================================
/**
 * 角色实体 —— 独立表，便于后期自由扩展角色与权限。
 *
 * 【设计说明】
 * - code 为唯一标识（admin / user / ...），业务代码用 code 判断权限，
 *   中文名 name 只用于前端展示，避免文案硬编码在逻辑里。
 * - 当前阶段预置 admin（管理员）、user（普通用户）两个角色；
 *   后期可在此表自由增删角色、并在 user_roles 里给用户绑定。
 *
 * 【字段说明】
 * - code        : 角色唯一标识，如 "admin" / "user"
 * - name        : 中文名，如 "管理员" / "普通用户"
 * - description : 角色说明（可选）
 */
model Role {
  id          String     @id @default(uuid()) @map("id")
  code        String     @unique @map("code")
  name        String     @map("name")
  description String?    @map("description")
  createdAt   DateTime   @default(now()) @map("created_at")

  users       UserRole[]

  @@map("roles")
}

// 【P1 新增】============================================
// UserRole 模型 —— 用户-角色关联表（多对多）
// ============================================
/**
 * 用户与角色的多对多关联表。
 *
 * 【为什么用多对多而非 User 上加单字段？】
 * 用户明确「后期要给不同用户绑定不同角色、控制菜单与权限」，
 * 多对多（一个用户可绑多个角色）是扩展性最稳的形态：
 * - 一个用户可同时具备多个角色（如既是普通用户又是审核员）
 * - 后期加「角色管理页」只需操作此关联表，不改 User 结构
 *
 * 【字段说明】
 * - userId / roleId : 复合主键 @@id([userId, roleId])，天然去重
 * - onDelete: Cascade —— 用户或角色删除时，关联记录自动清理
 */
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// 【P2 新增】============================================
// SystemConfig 模型 —— 系统配置表（只存「覆盖值」）
// ============================================
/**
 * 系统级可配置项（全局共享，非用户级）。
 *
 * 【核心设计：覆盖值模型】
 * - 本表只存「被管理员覆盖过的值」，未覆盖的配置项不在本表出现；
 * - 配置项的「默认值 + 类型 + 元数据」统一登记在代码里的 CONFIG_SCHEMA
 *   注册表（config/schema.ts），本表仅负责「覆盖 + 持久化」。
 * - 读取时三级回退：本表 value → 环境变量（部分项）→ 注册表默认值。
 *
 * 【为什么用 key-value（EAV）而非结构化字段？】
 * 配置项会持续增加，key-value 加项不改表结构；类型约束由注册表承担。
 *
 * 【字段说明】
 * - key     : 配置键，对应注册表的 key，如 "prompt.resume_expert"
 * - value   : 覆盖值（Json，类型由注册表约束）。string/number/boolean/json/json-array
 *             都存 Json；file 类型预留，value 存 fileId（当前无实际 file 项）
 * - enabled : 是否启用该覆盖值。false 时读取回退默认值（临时禁用覆盖，
 *             但保留 value，方便随时重新启用，无需重新填值）
 * - updatedAt / updatedBy : 审计字段（最后修改时间 / 修改人 userId）
 */
model SystemConfig {
  key       String   @id @map("key")
  value     Json?    @map("value")
  /// 配置值类型（string/textarea/number/boolean/json/json-array/file）。
  /// 注册表项的类型由 CONFIG_SCHEMA 承担，此字段主要供「动态配置」（自定义 key）使用。
  type      String   @default("string") @map("type")
  /// 中文名（动态配置「见名知意」展示用；注册表项用注册表 label，此字段可空）
  label     String?  @map("label")
  enabled   Boolean  @default(true) @map("enabled")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("system_configs")
}
