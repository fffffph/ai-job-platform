/**
 * ============================================
 * Prisma Schema —— 数据库模型定义（Prisma 7）
 * ============================================
 *
 * 【Prisma 7 变更说明】
 * datasource 块中不再支持 `url` 属性。
 * 数据库连接 URL 通过 prisma.config.ts 配置（迁移时使用）
 * 和 PrismaClient 构造函数的 datasourceUrl 参数（运行时使用）。
 *
 * 【迁移命令（Prisma 7）】
 * npx prisma db push       → 同步 schema 到数据库（本项目使用此方式，无 migrations 目录）
 * npx prisma generate      → 生成 Prisma Client 类型
 * npx prisma studio        → 打开数据库可视化界面
 *
 * @see https://pris.ly/d/config-datasource
 */

generator client {
  provider = "prisma-client-js"
}

/**
 * 数据源：PostgreSQL
 *
 * Prisma 7 中 url 配置已移至 prisma.config.ts 和 PrismaClient 构造函数。
 * 此 datasource 块仅声明数据库类型。
 */
datasource db {
  provider = "postgresql"
}

/**
 * ============================================
 * User 模型 —— 用户表
 * ============================================
 *
 * 【字段说明】
 * - id        : UUID 主键，自动生成，全局唯一
 * - email     : 邮箱，唯一索引，登录标识之一
 * - phone     : 手机号，唯一索引，登录标识之一
 * - username  : 用户名（账号），唯一索引，登录标识之一
 * - password  : 密码哈希（bcrypt 加密后的密文，不存储明文！），可空
 * - name      : 用户昵称/姓名，可选（仅展示用，不是登录标识）
 * - avatar    : 头像图片 URL，null 时前端用首字母占位
 * - bio       : 个人简介，可选
 * - remark    : 管理员备注（新增用户时填写，仅管理侧可见）
 * - status    : 账号状态（active | disabled），停用后不可登录（RBAC 权限体系 P0-11）
 * - createdAt : 注册时间，自动生成
 * - updatedAt : 最后更新时间，Prisma 自动管理
 *
 * 【统一账号标识设计（A-P0 新增）】
 * 三个登录标识 email / phone / username 全部「唯一 + 可空」，原因：
 * 1. PostgreSQL 唯一索引对 NULL 不生效——多行 NULL 互不冲突，
 *    因此无需用空字符串或占位符凑数，缺失的标识就存 NULL；
 * 2. 「至少有一个标识非空」由应用层统一保证
 *    （server/src/lib/identifier.ts 的 assertHasLoginIdentity），
 *    注册、管理员新增用户、绑定标识三处复用同一个函数，不散落判断。
 *
 * 【password 为什么可空？】
 * 验证码登录（OTP）与第三方 OAuth 用户天然没有密码；
 * 管理员新增用户也支持「不设密码、走邀请」模式。
 * 这类账号用密码登录时会被明确提示「该账号未设置密码，请用验证码登录」。
 * 存量用户全部有密码，改可空不影响现有登录。
 *
 * 【安全设计】
 * 密码字段不存储明文！注册时通过 bcrypt.hash() 加密后存入数据库，
 * 登录时通过 bcrypt.compare() 比对明文与密文。
 *
 * 【索引说明】
 * @@unique([email]) / @@unique([phone]) / @@unique([username])
 *   — 唯一约束同时自动创建索引，加速按任一标识登录查询；
 * @@index([deletedAt])
 *   — 软删除后几乎所有查询都带 deletedAt: null 条件，加索引避免全表扫描。
 */
model User {
  id        String   @id @default(uuid()) @map("id")
  /** 邮箱（登录标识之一，可空但唯一） */
  email     String?  @unique @map("email")
  /** 手机号（登录标识之一，可空但唯一；存 11 位纯数字，不带区号/分隔符） */
  phone     String?  @unique @map("phone")
  /** 用户名 / 账号（登录标识之一，可空但唯一；^[a-zA-Z0-9_-]{3,20}$ 且禁止纯数字） */
  username  String?  @unique @map("username")
  /**
   * 密码哈希（bcrypt）。
   * 可空：验证码登录 / OAuth 用户 / 管理员「不设密码」创建的账号没有密码。
   */
  password  String?  @map("password")
  /** 昵称（仅展示，非登录标识；可与 username 不同） */
  name      String?  @map("name")
  avatar    String?  @map("avatar")
  bio       String?  @map("bio")
  /** 管理员备注（新增用户时填写，不返回给非管理侧） */
  remark    String?  @map("remark")
  /**
   * 账号状态（active | disabled）
   * - active  : 正常，可登录
   * - disabled: 已停用，登录被拒 + 已登录 token 请求被踢下线
   * 使用 @default("active") 保证存量用户同步后全部为 active，不影响现有登录。
   */
  status    String   @default("active") @map("status")

  /**
   * 首次登录是否强制修改密码。
   * 管理员代建账号（用默认密码/随机密码）时置 true，
   * 前端在 dashboard 布局层拦截并跳转个人中心改密。
   */
  mustChangePassword Boolean @default(false) @map("must_change_password")

  /**
   * Token 版本号 —— JWT 主动失效机制。
   *
   * 【为什么需要它】
   * 原实现里 JWT 有效期 7 天，authMiddleware 只校验 status，
   * 导致「改密码 / 管理员重置密码 / 强制下线」后，旧 Token 在过期前依然可用，
   * 这是实实在在的安全漏洞。
   *
   * 【怎么用】
   * 签发 JWT 时把 tokenVersion 写入 payload 的 tv 字段；
   * authMiddleware 查库时一并取出 tokenVersion 比对，不一致直接 401 TOKEN_REVOKED。
   * 改密码 / 重置密码 / 强制下线 / 解绑登录标识时执行 tokenVersion++，
   * 该用户所有已签发的旧 Token 立即失效。
   */
  tokenVersion       Int       @default(0) @map("token_version")

  /** 最后登录时间（登录成功时回写，用户列表展示用） */
  lastLoginAt        DateTime? @map("last_login_at")
  /** 最后登录 IP（登录成功时回写，安全审计用） */
  lastLoginIp        String?   @map("last_login_ip")
  /** 最后登录方式：password | email_otp | sms_otp | oauth */
  lastLoginMethod    String?   @map("last_login_method")

  /**
   * 软删除标记（null 表示未删除）。
   *
   * 【为什么必须软删除】
   * User 被 user_profiles / documents / chunks / knowledge_files / trace_runs
   * 以 onDelete: Cascade 关联，物理删除会连带清空该用户的全部简历、
   * 知识库文档与 AI 执行轨迹，属于不可逆的数据灾难。
   *
   * 【使用约定】
   * 所有按 id / 标识查 User 的地方都必须带 deletedAt: null 条件，
   * 统一走 server/src/lib/user-query.ts 的 findActiveUser 系列封装，避免遗漏。
   */
  deletedAt          DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /**
   * DeepSeek API Key 密文（用户自行配置，服务端 AES-256-GCM 加密后存储）
   * - 明文绝不入库、绝不写日志、绝不返回前端
   * - 按用户隔离，只有本用户能通过认证接口读写
   * - null 表示未配置
   */
  deepseekKeyCipher    String?  @map("deepseek_key_cipher")
  /** DeepSeek API Key 最后配置/更新时间 */
  deepseekKeyUpdatedAt DateTime? @map("deepseek_key_updated_at")

  /**
   * SiliconFlow（硅基流动）API Key 密文（用户自行配置，服务端 AES-256-GCM 加密后存储）
   * 用于知识库 RAG 的 Embedding 向量化，与 DeepSeek Key 一样按用户隔离加密存储
   */
  siliconflowKeyCipher    String?  @map("siliconflow_key_cipher")
  /** SiliconFlow API Key 最后配置/更新时间 */
  siliconflowKeyUpdatedAt DateTime? @map("siliconflow_key_updated_at")

  // 【P5 新增】用户求职画像（1:1，用于职位推荐的个性化记忆）
  profile UserProfile?

  // 【P1 角色地基】用户-角色多对多关联（用于权限控制与菜单过滤）
  userRoles UserRole[]

  @@index([deletedAt])
  @@map("users")
}

// 【P5 新增】============================================
// UserProfile 模型 —— 用户求职画像
// ============================================
/**
 * 用户求职画像（Memory 层的结构化记忆）
 *
 * 存储用户的求职偏好，供职位发现 Agent 做个性化推荐时读取，
 * 实现「跨轮记忆」——用户首次填写求职意向后，下次无需重复输入。
 *
 * 【字段说明】
 * - city           : 期望城市（如 "西安"）
 * - skills         : 技能栈（如 "React,TypeScript,微前端,Node.js"）
 * - expectedSalary : 期望薪资（如 "12k-18k"）
 * - jobTitle       : 求职方向/岗位（如 "前端开发工程师"）
 *
 * 【1:1 关系】
 * 每个用户至多一条画像记录，userId 唯一索引保证。
 */
model UserProfile {
  id             String   @id @default(uuid()) @map("id")
  userId         String   @unique @map("user_id")
  jobTitle       String?  @map("job_title")
  city           String?  @map("city")
  skills         String?  @map("skills")
  expectedSalary String?  @map("expected_salary")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// 【P3 新增】============================================
// Document 模型 —— 知识库文档
// ============================================
/// 知识库文档（用户上传的面试题/JD/笔记等）
model Document {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @map("user_id")
  title     String   @map("title")
  content   String   @map("content")          // 原始全文（保留，供溯源）
  keywords  String?  @map("keywords")          // 逗号分隔检索词（提升检索命中，选填）
  category  String?  @map("category")          // 分类标签（如「前端/React」，选填）
  createdAt DateTime @default(now()) @map("created_at")

  chunks    Chunk[]

  @@index([userId])
  @@map("documents")
}

// 【知识库文件真相源】============================================
// KnowledgeFile 模型 —— 用户上次上传的原始 Excel 文件
// ============================================
/// 用户上次上传的原始 Excel 文件（供「下载上次文件」继续编辑）
model KnowledgeFile {
  id        String   @id @default(uuid()) @map("id")
  userId    String   @unique @map("user_id")
  filename  String   @map("filename")
  content   Bytes    @map("content")          // 原始 .xlsx 字节
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("knowledge_files")
}

// 【P3 新增】============================================
// Chunk 模型 —— 文档分块（含向量）
// ============================================
/// 文档分块（含向量）
model Chunk {
  id          String   @id @default(uuid()) @map("id")
  documentId  String   @map("document_id")
  chunkIndex  Int      @map("chunk_index")     // 分块序号，用于溯源定位
  content     String   @map("content")          // 分块文本
  embedding   Unsupported("vector(1024)")?      // 1024 维向量（bge-m3）
  createdAt   DateTime @default(now()) @map("created_at")

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunks")
}

// 【P6 新增】============================================
// TraceRun 模型 —— 一次 AI 执行（Trace 落库）
// ============================================
/// 一次 AI 图执行的可观测记录（P6 把 trace 从内存落库）
/// 一次「简历分析 / 知识库问答 / 职位推荐」对应一条 run，
/// 下挂多条节点级 TraceEvent，实现决策过程的持久化与历史回放。
model TraceRun {
  id              String   @id @default(uuid()) @map("id")
  userId          String   @map("user_id")
  /// 图类型：resume（简历分析）/ rag（知识库问答）/ jobs（职位发现）
  type            String   @map("type")
  /// 执行结果：success / error
  status          String   @default("success") @map("status")
  /// 节点数量
  nodeCount       Int      @default(0) @map("node_count")
  /// 总耗时（毫秒，各节点 durationMs 之和）
  totalDurationMs Int      @default(0) @map("total_duration_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  events          TraceEvent[]

  @@index([userId, createdAt])
  @@map("trace_runs")
}

// 【P6 新增】============================================
// TraceEvent 模型 —— 单个节点执行事件（Trace 落库）
// ============================================
/// 单个 AI 节点的执行追踪记录（持久化版）
/// input/output 存 JSON（Json 类型），序列化失败时降级为 null。
model TraceEvent {
  id         String   @id @default(uuid()) @map("id")
  runId      String   @map("run_id")
  nodeName   String   @map("node_name")
  /// 节点执行顺序（从 0 开始，用于回放时保持原始顺序）
  order      Int      @map("event_order")
  /// 节点输入（JSON，已脱敏/序列化）
  input      Json?    @map("input")
  /// 节点输出（JSON）
  output     Json?    @map("output")
  durationMs Int      @map("duration_ms")
  /// 事件发生时间（ISO 8601 字符串，保留原始值）
  timestamp  String   @map("timestamp")
  createdAt  DateTime @default(now()) @map("created_at")

  run        TraceRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("trace_events")
}

// 【P1 新增】============================================
// Role 模型 —— 角色表（RBAC 权限地基）
// ============================================
/**
 * 角色实体 —— 独立表，便于后期自由扩展角色与权限。
 *
 * 【设计说明】
 * - code 为唯一标识（admin / user / ...），业务代码用 code 判断权限，
 *   中文名 name 只用于前端展示，避免文案硬编码在逻辑里。
 * - 当前阶段预置 admin（管理员）、user（普通用户）两个角色；
 *   后期可在此表自由增删角色、并在 user_roles 里给用户绑定。
 *
 * 【字段说明】
 * - code        : 角色唯一标识，如 "admin" / "user"
 * - name        : 中文名，如 "管理员" / "普通用户"
 * - description : 角色说明（可选）
 * - isSystem    : 是否系统内置角色（admin/user=true）。内置角色不可删除，
 *                 防止误删导致系统锁死（RBAC 权限体系 D4/A3）
 */
model Role {
  id          String     @id @default(uuid()) @map("id")
  code        String     @unique @map("code")
  name        String     @map("name")
  description String?    @map("description")
  isSystem    Boolean    @default(false) @map("is_system")
  createdAt   DateTime   @default(now()) @map("created_at")

  users       UserRole[]
  // 【RBAC 权限体系】角色-菜单绑定（多对多）。admin 角色不写绑定（走代码短路）。
  menus       RoleMenu[]

  @@map("roles")
}

// 【P1 新增】============================================
// UserRole 模型 —— 用户-角色关联表（多对多）
// ============================================
/**
 * 用户与角色的多对多关联表。
 *
 * 【为什么用多对多而非 User 上加单字段？】
 * 用户明确「后期要给不同用户绑定不同角色、控制菜单与权限」，
 * 多对多（一个用户可绑多个角色）是扩展性最稳的形态：
 * - 一个用户可同时具备多个角色（如既是普通用户又是审核员）
 * - 后期加「角色管理页」只需操作此关联表，不改 User 结构
 *
 * 【字段说明】
 * - userId / roleId : 复合主键 @@id([userId, roleId])，天然去重
 * - onDelete: Cascade —— 用户或角色删除时，关联记录自动清理
 */
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// 【P2 新增】============================================
// SystemConfig 模型 —— 系统配置表（只存「覆盖值」）
// ============================================
/**
 * 系统级可配置项（全局共享，非用户级）。
 *
 * 【核心设计：覆盖值模型】
 * - 本表只存「被管理员覆盖过的值」，未覆盖的配置项不在本表出现；
 * - 配置项的「默认值 + 类型 + 元数据」统一登记在代码里的 CONFIG_SCHEMA
 *   注册表（config/schema.ts），本表仅负责「覆盖 + 持久化」。
 * - 读取时三级回退：本表 value → 环境变量（部分项）→ 注册表默认值。
 *
 * 【为什么用 key-value（EAV）而非结构化字段？】
 * 配置项会持续增加，key-value 加项不改表结构；类型约束由注册表承担。
 *
 * 【字段说明】
 * - key     : 配置键，对应注册表的 key，如 "prompt.resume_expert"
 * - value   : 覆盖值（Json，类型由注册表约束）。string/number/boolean/json/json-array
 *             都存 Json；file 类型预留，value 存 fileId（当前无实际 file 项）
 * - enabled : 是否启用该覆盖值。false 时读取回退默认值（临时禁用覆盖，
 *             但保留 value，方便随时重新启用，无需重新填值）
 * - updatedAt / updatedBy : 审计字段（最后修改时间 / 修改人 userId）
 */
model SystemConfig {
  key       String   @id @map("key")
  value     Json?    @map("value")
  /// 配置值类型（string/textarea/number/boolean/json/json-array/file）。
  /// 注册表项的类型由 CONFIG_SCHEMA 承担，此字段主要供「动态配置」（自定义 key）使用。
  type      String   @default("string") @map("type")
  /// 中文名（动态配置「见名知意」展示用；注册表项用注册表 label，此字段可空）
  label     String?  @map("label")
  enabled   Boolean  @default(true) @map("enabled")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("system_configs")
}

// 【RBAC 权限体系 新增】============================================
// Menu 模型 —— 菜单（目录/菜单/按钮 三类型统一建模，自引用成树）
// ============================================
/**
 * 菜单实体 —— 以单表自引用（parentId）建模「目录 / 菜单 / 按钮」三种节点，
 * 其中 button 的 code 即「按钮级权限码」，纳入角色-菜单绑定（RoleMenu）统一授权。
 *
 * 【字段说明】
 * - parentId  : 父级菜单 id，null 表示顶级（自引用关系 MenuTree）
 * - type      : 节点类型 catalog（目录）| menu（菜单）| button（按钮）
 * - code      : 唯一标识，同时作为「权限码」；需符合命名规范 ^[a-z][a-z0-9:_-]*$
 * - path      : 路由路径（button 为空）
 * - component : 前端组件/子应用标识（预留，可选）
 * - icon      : 图标名（前端做「字符串 → 图标组件」映射，button 为空）
 * - sort      : 排序值（同级升序）
 * - visible   : 是否显示在侧边栏（button 忽略）
 * - status    : 启用状态 active | disabled（disabled 对所有角色不可见）
 */
model Menu {
  id         String   @id @default(uuid()) @map("id")
  parentId   String?  @map("parent_id")
  type       String   @map("type")            // catalog | menu | button
  code       String   @unique @map("code")    // 唯一标识；button 即权限码
  name       String   @map("name")
  path       String?  @map("path")
  component  String?  @map("component")
  icon       String?  @map("icon")
  sort       Int      @default(0) @map("sort")
  visible    Boolean  @default(true) @map("visible")
  status     String   @default("active") @map("status") // active | disabled
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  parent     Menu?     @relation("MenuTree", fields: [parentId], references: [id])
  children   Menu[]    @relation("MenuTree")
  roles      RoleMenu[]

  @@index([parentId])
  @@map("menus")
}

// 【A-P1 新增】============================================
// VerificationCode 模型 —— 验证码表（登录 / 找回密码 / 绑定标识）
// ============================================
/**
 * 验证码记录（邮箱 / 短信）。
 *
 * 【为什么用独立表而非 Redis】
 * 项目部署栈（5 容器：web / server / subapp / postgres / nginx）没有 Redis，
 * 为验证码多起一个容器不划算；PostgreSQL 扛这个量级绰绰有余，还能顺便获得
 * 审计能力。将来并发上来了再换 Redis，接口层不用改。
 *
 * 【安全设计（每一条都是防「短信/邮件轰炸」的必需品）】
 * - 只存 codeHash（HMAC-SHA256），明文永不落库、永不写日志；
 * - 校验失败累计 attempts 次即作废（须重新获取）；
 * - 一次性消费：consumed_at 标记后同一码不可复用（防重放）；
 * - 频控在应用层做（verification.service），本表提供 attempts/max_attempts
 *   供校验失败计数，request_ip 供「同 IP 每日上限」统计。
 *
 * 【字段说明】
 * - target     : 收码目标（邮箱地址 / 手机号，已归一化）
 * - channel    : 发送通道 email | sms
 * - scene      : 业务场景 login | reset_password（后续可扩展 bind_email/bind_phone）
 * - code_hash  : HMAC-SHA256(code, secret + target) 的十六进制字符串
 * - expires_at : 过期时间（发送时间 + auth.otp.ttl_seconds）
 * - attempts   : 已累计的校验失败次数（达到 max_attempts 即作废）
 * - max_attempts: 允许的最大校验失败次数（默认 5）
 * - consumed_at: 校验成功时间（null 表示未消费）
 * - request_ip : 发起发送请求的客户端 IP（用于同 IP 频控统计）
 */
model VerificationCode {
  id           String    @id @default(uuid()) @map("id")
  target       String    @map("target")
  channel      String    @map("channel") // email | sms
  scene        String    @map("scene") // login | reset_password | ...
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attempts     Int       @default(0) @map("attempts")
  maxAttempts  Int       @default(5) @map("max_attempts")
  consumedAt   DateTime? @map("consumed_at")
  requestIp    String?   @map("request_ip")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([target, scene, createdAt])
  @@map("verification_codes")
}

// 【RBAC 权限体系 新增】============================================
// RoleMenu 模型 —— 角色-菜单绑定（多对多，双向级联删除）
// ============================================
/**
 * 角色与菜单的多对多关联表（授权单元）。
 *
 * 【字段说明】
 * - roleId / menuId : 复合主键 @@id([roleId, menuId])，天然去重
 * - 双向 onDelete: Cascade —— 角色或菜单删除时，绑定记录自动清理
 *
 * 【admin 约定】admin 角色永不写本表记录，鉴权/取菜单时按角色名短路返回全量，
 * 从根本上避免「绑定数据与代码规则冲突」导致管理员被锁死。
 */
model RoleMenu {
  roleId String @map("role_id")
  menuId String @map("menu_id")
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  @@id([roleId, menuId])
  @@map("role_menus")
}
