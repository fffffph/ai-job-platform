# ============================================
# 后端服务环境变量配置（示例模板）
# ============================================
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填写真实值（尤其 DATABASE_URL / JWT_SECRET / 各 API Key）
#   3. .env 已加入 .gitignore，切勿提交到仓库
#
# 说明：此文件存储敏感配置（数据库连接、密钥等），
#       请确保 .env 已添加到 .gitignore 中！

# ---------- 服务器配置 ----------
# 服务端口号，默认 4000（避免与 Next.js 3000 冲突）
PORT=4000

# ---------- 数据库配置 ----------
# PostgreSQL 连接字符串格式：
# postgresql://用户名:密码@主机:端口/数据库名
# 本地开发默认值，请根据实际 PostgreSQL 配置修改
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careerai?schema=public"

# ---------- JWT 密钥 ----------
# ⚠️ 生产环境请使用随机生成的强密码（至少 32 位）
# 生成方式：openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-32-bytes-secret"

# ---------- JWT 过期时间 ----------
# 格式：数字 + 单位（s/m/h/d）
# 例如：7d = 7天，24h = 24小时
JWT_EXPIRES_IN="7d"

# ---------- Bcrypt 加密强度 ----------
# 盐轮数：数值越大越安全但越慢，推荐 10~12
BCRYPT_SALT_ROUNDS=10

# ---------- AI 服务（DeepSeek）----------
# DeepSeek API Key - https://platform.deepseek.com/
# 【重要】现在优先使用「用户在个人中心自行配置的 Key」，
# 此变量仅作为可选的服务端兜底默认值（用户未配置时才使用）。
# 开发环境留空时相关功能会使用 Mock 数据返回，便于联调测试
# ⚠️ 生产环境建议配置真实 Key
DEEPSEEK_API_KEY=

# ---------- DeepSeek Key 加密 ----------
# 用于加密存储用户配置的 DeepSeek API Key（AES-256-GCM）。
# ⚠️ 留空则回退用 JWT_SECRET 派生密钥；生产环境建议显式配置，
#    且配置后不要随意更改，否则已存密文无法解密。
# 生成方式：openssl rand -base64 32
DEEPSEEK_ENCRYPTION_KEY=

# ---------- AI 服务（SiliconFlow）----------
# SiliconFlow API Key - https://cloud.siliconflow.cn/me/account/ak
# 用于 Embedding（向量化），同样优先使用用户在个人中心配置的 Key
# ⚠️ 生产环境建议配置真实 Key
SILICONFLOW_API_KEY=

# ---------- 邮件验证码通道（SMTP）----------
# 发送通道：console=控制台打印（开发/演示默认），smtp=真实邮件（生产）
# 保持 console 时，验证码会打印到后端控制台，便于本地联调
MAIL_PROVIDER=console

# 当 MAIL_PROVIDER=smtp 时，以下 5 项必填（缺一不可）：
#   SMTP_HOST  邮箱 SMTP 服务器地址
#   SMTP_PORT  端口：465=SSL 加密，587=STARTTLS（代码按端口自动判断 secure）
#   SMTP_USER  发件邮箱账号（一般就是完整邮箱地址）
#   SMTP_PASS  SMTP 授权码 / 应用专用密码（⚠️ 不是邮箱登录密码！）
#   SMTP_FROM  发件人地址（建议与 SMTP_USER 一致，否则易进垃圾箱或被拒收）
#
# 常见邮箱 SMTP 对照（各家都需在邮箱设置里开启 SMTP 服务并获取「授权码」）：
#   QQ 邮箱    smtp.qq.com         465 / 587
#   163 邮箱   smtp.163.com        465 / 994
#   126 邮箱   smtp.126.com        465
#   Gmail      smtp.gmail.com      465 / 587（需应用专用密码）
#   Outlook    smtp.office365.com  587
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 发件人显示名（收件箱里展示的名字，可选，默认 CareerAI）
SMTP_FROM_NAME=CareerAI
